{
  "name": "ygdria-demo",
  "version": "11.0.58",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:lore": "node tools/sync-humanos-lore.mjs",
    "check:lore": "node tools/sync-humanos-lore.mjs --check",
    "pretest": "pnpm run sync:lore",
    "check": "node --check humanos-lore-v10.js && node --check game-v10.js && node --check v10-config.js && node --check v10-animations.js && node --check sw.js && pnpm run check:lore",
    "test:contracts": "node tests/v10-contracts.mjs",
    "test:assets": "node tests/v10-assets.mjs",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:production": "playwright test --config=playwright.config.mjs --grep @production",
    "test": "pnpm run check && pnpm run test:contracts && pnpm run test:assets"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0"
}
